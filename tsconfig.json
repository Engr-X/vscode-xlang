{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["node", "mocha"],
        "outDir": "out",
        "rootDir": ".",
        "strict": true,
        "sourceMap": true
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
