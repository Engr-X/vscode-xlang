{
    "name": "XLang",
    "scopeName": "source.xlang",
    "patterns": [
        {
            "name": "XLang",
            "scopeName": "source.xlang",
            "patterns": [
                {
                    "name": "comment.line.double-slash.xlang",
                    "begin": "//",
                    "end": "$",
                    "patterns": [
                        {
                            "include": "#commentTags"
                        }
                    ]
                },
                {
                    "name": "comment.block.xlang",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        {
                            "include": "#commentTags"
                        }
                    ]
                }
            ],
            "repository": {
                "commentTags": {
                    "name": "storage.type.annotation.xlang",
                    "match": "@(author|version|since|param|return|throws|exception|see|deprecated|hidden|apiNote|implSpec|implNote|info|note|warning|todo|example|internal|experimental|security)\\b"
                }
            }
        },
        {
            "name": "string.quoted.double.xlang",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.xlang",
                    "match": "\\\\."
                },
                {
                    "name": "meta.interpolation.xlang",
                    "match": "(\\{)([A-Za-z_][A-Za-z0-9_]*)(\\})",
                    "captures": {
                        "1": {
                            "name": "punctuation.section.interpolation.begin.xlang"
                        },
                        "2": {
                            "name": "variable.other.interpolation.xlang"
                        },
                        "3": {
                            "name": "punctuation.section.interpolation.end.xlang"
                        }
                    }
                },
                {
                    "name": "constant.character.escape.xlang",
                    "match": "%%"
                },
                {
                    "name": "variable.parameter.format.xlang",
                    "match": "%[-+# 0]*\\d*(?:\\.\\d+)?[sdifuxXocFeEgG]"
                }
            ]
        },
        {
            "name": "string.quoted.single.xlang",
            "begin": "'",
            "end": "'",
            "patterns": [
                {
                    "name": "constant.character.escape.xlang",
                    "match": "\\\\."
                }
            ]
        },
        {
            "name": "keyword.control.xlang",
            "match": "\\b(and|as|break|continue|elif|else|from|for|if|iff|implies|import|inv|is|loop|nand|new|niff|nimplies|nor|or|package|pass|repeat|return|shl|shr|until|ushr|while|xnor|xor)\\b"
        },
        {
            "name": "storage.type.xlang",
            "match": "\\b(class|fun|struct|val|var)\\b"
        },
        {
            "name": "storage.modifier.xlang",
            "match": "\\b(inline|intrinsic|mut|native|private|protected|public|static)\\b"
        },
        {
            "name": "constant.language.null.xlang",
            "match": "\\b(null|true|false)\\b"
        },
        {
            "name": "support.type.primitive.xlang",
            "match": "\\b(bool|byte|char|short|int|long|float|double|pointer)\\b"
        }
    ]
}
